# ──────────────────────────────────────────────────────────────────────────────
# Wollo University Exam Prep — environment variable template
# Copy to .env and fill in your values.
# Find all values at: https://app.supabase.com → Project settings → API
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / publishable key (safe to expose in the browser via VITE_ prefix)
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY

# Secret key — server-side ONLY, never prefix with VITE_
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# JWKS URL for server-side JWT verification
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
